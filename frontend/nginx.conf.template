server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Cache built assets aggressively; they are content-hashed by Vite.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Reverse-proxy the API so the SPA and API share one origin (cookies work).
  location /api/ {
    # Compose keeps the default (api:4000, the compose service name); Coolify
    # overrides API_UPSTREAM with the API application's internal hostname.
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SPA fallback: every non-file route serves index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
