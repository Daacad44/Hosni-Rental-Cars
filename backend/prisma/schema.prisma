// Car rental management system — Prisma schema.
// Module 1 (auth & staff accounts) foundation. Later modules extend this file.
// organizationId is the security boundary and is indexed on every model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  AGENT
  MECHANIC
}

enum Locale {
  so
  en
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  // IANA timezone; "Nightly" jobs run at 02:00 in this zone, not UTC.
  timezone  String   @default("Africa/Mogadishu")
  currency  String   @default("USD")
  // VAT applied to rentals, exclusive. Stored as a percentage, e.g. 5.00 = 5%.
  vatRate   Decimal  @default(5.00) @db.Decimal(5, 2)
  // Minutes past a full day before the next day begins to be charged.
  graceMinutes Int   @default(59)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]
  auditLogs AuditLog[]
  vehicles  Vehicle[]
  customers Customer[]
  rateCards RateCard[]
  reservations Reservation[]
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  timezone       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users    User[]
  vehicles Vehicle[]

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name         String
  email        String
  passwordHash String
  role         Role
  locale       Locale   @default(so)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  // Email is unique per organization, not globally.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([branchId])
}

model RefreshToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha-256 of the raw token; the raw value only ever lives in the cookie.
  tokenHash      String    @unique
  // Rotation family: a rotated token points back at the one it replaced.
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

// ── Module 2: Fleet & vehicles ──────────────────────────────────────────────

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum VehicleDocumentType {
  INSURANCE
  REGISTRATION
  INSPECTION
  PERMIT
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  plateNumber  String
  vin          String
  make         String
  model        String
  year         Int
  // Category is organization-defined free text; rate cards key on it.
  category     String
  transmission Transmission
  fuelType     FuelType
  seats        Int
  colour       String
  // Odometer in kilometres. Monotonic: a lower reading needs a manager override.
  odometer     Int          @default(0)

  acquisitionCost Decimal  @db.Decimal(12, 2)
  acquisitionDate DateTime

  // The only manual status override (§5.2). All other states are derived from
  // active agreements, reservations, and open maintenance at read time.
  isOutOfService     Boolean @default(false)
  outOfServiceReason String?

  // Soft delete: hidden from lists, retained on historical agreements.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos    VehiclePhoto[]
  documents VehicleDocument[]

  // Plate is unique per organization among live rows. Enforced by a partial
  // unique index (WHERE deletedAt IS NULL) added in the migration, so a plate
  // can be reused after a vehicle is soft-deleted.
  @@index([organizationId, plateNumber])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, category])
}

model VehiclePhoto {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // Object-storage key in the private bucket; served only via signed URLs.
  storageKey     String
  contentType    String
  sizeBytes      Int
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([vehicleId])
  @@index([organizationId])
}

model VehicleDocument {
  id             String              @id @default(cuid())
  organizationId String
  vehicleId      String
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type           VehicleDocumentType
  number         String
  issueDate      DateTime
  // Indexed: a nightly job scans it for upcoming expiry (built in the alerts module).
  expiryDate     DateTime
  storageKey     String?
  contentType    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([vehicleId])
  @@index([organizationId, expiryDate])
}

// ── Module 3: Customers ─────────────────────────────────────────────────────

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName      String
  phone         String
  email         String?
  nationalId    String?
  licenceNumber String?
  licenceExpiry DateTime?
  address       String?
  notes         String?

  // Scans held in the private bucket, served via signed URLs only.
  licenceScanKey String?
  idScanKey      String?

  isBlocked   Boolean   @default(false)
  blockReason String?
  blockedAt   DateTime?
  blockedById String?

  // Duplicate merge is a soft delete of the losing record onto the winner.
  mergedIntoId String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phone is unique per organization among live rows (partial index in migration).
  @@index([organizationId])
  @@index([organizationId, phone])
  // A GIN trigram index on fullName is added in the migration for forgiving search.
}

// ── Module 4: Pricing & rate cards ──────────────────────────────────────────

model RateCard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category String
  // Null = the category card. Set = an override for one specific vehicle.
  vehicleId String?

  dailyRate        Decimal  @db.Decimal(12, 2)
  weeklyRate       Decimal? @db.Decimal(12, 2)
  monthlyRate      Decimal? @db.Decimal(12, 2)
  // Null = UNLIMITED included kilometres, which is different from zero.
  includedKmPerDay Int?
  extraKmRate      Decimal  @db.Decimal(12, 2)
  depositAmount    Decimal  @db.Decimal(12, 2)
  lateHourRate     Decimal  @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, category, effectiveFrom])
  @@index([organizationId, vehicleId, effectiveFrom])
}

// ── Module 5: Reservations & availability ───────────────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  CONVERTED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  customerId     String

  // A reservation targets a category, with a specific vehicle assigned before
  // pickup. vehicleId is null until assigned.
  category  String
  vehicleId String?

  startAt DateTime
  endAt   DateTime
  status  ReservationStatus @default(PENDING)

  // The quote is computed server-side and stored; the agreement inherits it.
  // rateValues is the exact rate snapshot so a later rate-card edit never alters
  // this reservation. quoteBreakdown is the full line-by-line breakdown.
  quotedTotal    Decimal @db.Decimal(12, 2)
  quotedDeposit  Decimal @db.Decimal(12, 2)
  rateValues     Json
  quoteBreakdown Json

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@index([vehicleId, startAt, endAt])
  @@index([customerId])
}
