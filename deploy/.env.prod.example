# Production environment for the single-VPS stack. Copy to .env.prod and fill in.
# Never commit .env.prod. Secrets must each be at least 32 characters:
#   openssl rand -base64 48

# ── Reverse proxy / TLS ──
# Both app.<DOMAIN> and api.<DOMAIN> must resolve to this host in public DNS.
DOMAIN=example.com
ACME_EMAIL=ops@example.com

# ── Postgres (consumed by the postgres service AND by DATABASE_URL below) ──
POSTGRES_USER=hosni
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hosni

# ── Backend runtime ──
NODE_ENV=production
PORT=4000

# Internal hostnames from the compose network (never localhost in a container).
# Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://hosni:change-me-strong-db-password@postgres:5432/hosni?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-32-chars

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
REFRESH_ROTATION_GRACE_SEC=10

# Exact browser origin of the SPA; CORS is locked to this with credentials.
CORS_ORIGIN=https://app.example.com

# One reverse-proxy hop (Caddy). Do not raise without adding real hops, or
# clients could spoof X-Forwarded-For and evade rate limiting.
TRUST_PROXY_HOPS=1

# Log level for the structured logger (fatal|error|warn|info|debug|trace).
LOG_LEVEL=info

# ── Error monitoring (optional but recommended) ──
# When set, unexpected 5xx errors and unhandled exceptions are reported here.
# Leave blank to disable (a warning is logged once at boot).
SENTRY_DSN=

# ── Object storage ──
# 'local' writes to the uploads volume; 's3' targets a private bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_TTL_SEC=300
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
