# Backend runtime configuration (validated at boot by backend/src/config/env.ts)
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hosni?schema=public
REDIS_URL=redis://localhost:6379

# Must each be at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-32-chars

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
REFRESH_ROTATION_GRACE_SEC=10

CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api/v1
